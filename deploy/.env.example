# ============================================================
# QuickBlue-MicroAI（MySQL 版）Docker 一键部署 - 环境变量
# ------------------------------------------------------------
# 使用：复制本文件为 deploy/.env 后按需修改（.env 不要提交到 git）
#   Linux/Mac:  cp .env.example .env
#   Windows:    copy .env.example .env
# 本文件同时供 docker-compose.yml 与全部后端容器使用
# （变量名与后端 nacos_config / .env.example 约定完全一致）
# ============================================================

# ---------- MySQL（容器初始化与服务连接） ----------
# 容器内 MySQL root 密码（init 脚本建库、服务连接共用此密码）
MYSQL_ROOT_PASSWORD=QuickBlue@2026
# 服务连接用（保持与 root 一致即可，服务经 nacos_config 注入 JDBC 地址）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=QuickBlue@2026

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=QuickBlue@2026
# 默认库号（business 服务单独覆盖为 3）
REDIS_DATABASE=1

# ---------- Nacos 注册中心 / 配置中心 ----------
# 容器网络内用服务名访问
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=QuickBlue-dev
NACOS_GROUP=QuickBlue_GROUP
# Nacos 鉴权默认关闭（内网部署），两项留空；开启鉴权时填管理员账号
NACOS_USERNAME=
NACOS_PASSWORD=

# ---------- 应用 ----------
# dev / test / prod（同时影响 Nacos 命名空间时请自行调整 NACOS_NAMESPACE）
SPRING_PROFILES_ACTIVE=prod

# ---------- SM4 API 加解密密钥 ----------
# ⚠️ 已改在 docker-compose.yml 中直接配置（密钥含 $ 字符，放本文件会被 compose
#    变量插值破坏）。修改密钥请改 compose 的 SM4_ENCRYPT_KEY（用 $$ 转义），
#    并同步修改前端 src/lib/encrypt.js 后重建前端镜像。

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- Ollama（可选：AI 知识库本地嵌入模型） ----------
# 仅当使用 `docker compose --profile ollama up -d` 启用本地模型时生效
OLLAMA_EMBED_MODEL=nomic-embed-text
