# ============================================================
# QuickBlue 环境变量清单（唯一配置来源）
# ------------------------------------------------------------
# 本地开发：
#   1. 复制本文件为项目根目录 .env：copy .env.example .env
#   2. 所有服务 bootstrap.yaml 已配置 spring.config.import 自动加载
#      项目根目录 .env，修改 .env 后重启服务即可生效，
#      无需再修改任何 yaml 文件（MySQL/Redis/Nacos 地址一处改，全局生效）
#   3. 未复制 .env 或变量未设置时，自动使用各 yaml 中的默认值（与本地开发一致）
# 服务器部署：
#   在系统环境变量 / docker-compose / k8s ConfigMap 中设置同名变量即可
# ============================================================

# ---------- Nacos 注册中心 / 配置中心 ----------
# 修改 Nacos 地址只需改 NACOS_SERVER_ADDR（如 192.168.1.100:8848）
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=QuickBlue-dev
NACOS_GROUP=QuickBlue_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=Nq963369!@

# ---------- MySQL ----------
# 修改 MySQL 地址只需改 MYSQL_HOST / MYSQL_PORT / MYSQL_USERNAME / MYSQL_PASSWORD
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=budaos

# ---------- Redis / Redisson ----------
# 修改 Redis 地址只需改 REDIS_HOST / REDIS_PORT / REDIS_PASSWORD / REDIS_DATABASE
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=budaos
# 默认 Redis 库号（business 服务单独覆盖为 3）
REDIS_DATABASE=1

# ---------- PostgreSQL / pgvector（ai 服务 RAG 功能，可选） ----------
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DB=quickblue_ai
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=123456

# ---------- Spring Boot Admin 监控中心 ----------
SPRING_BOOT_ADMIN_URL=http://localhost:9090

# ---------- 环境 ----------
# dev / test / prod，切换环境时同时切换 Nacos 命名空间
# 注意：profile 切换建议通过 IDE 启动配置或命令行 --spring.profiles.active 指定，
# 此处设置仅对普通属性占位符生效（${SPRING_PROFILES_ACTIVE:dev}）
SPRING_PROFILES_ACTIVE=dev

# ---------- Sentinel（如后续接入） ----------
# SENTINEL_DASHBOARD_ADDR=localhost:8858
