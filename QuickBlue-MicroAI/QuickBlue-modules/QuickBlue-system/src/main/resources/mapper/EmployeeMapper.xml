<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.budaos.system.dao.StaffDao">

    <select id="countByDepartmentId" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM t_employee
        WHERE department_id = #{departmentId}
        <if test="deletedFlag != null">
            AND deleted_flag = #{deletedFlag}
        </if>
    </select>

    <select id="getEmployeeIdByDepartmentId" resultType="java.lang.Long">
        SELECT employee_id
        FROM t_employee
        WHERE department_id = #{departmentId}
        <if test="disabledFlag != null">
            AND disabled_flag = #{disabledFlag}
        </if>
        AND deleted_flag = 0
    </select>

    <select id="getEmployeeIdByDepartmentIdList" resultType="java.lang.Long">
        SELECT DISTINCT employee_id
        FROM t_employee
        WHERE department_id IN
        <foreach collection="departmentIds" open="(" close=")" item="item" separator=",">
            #{item}
        </foreach>
        <if test="disabledFlag != null">
            AND disabled_flag = #{disabledFlag}
        </if>
        AND deleted_flag = 0
    </select>

    <select id="queryByDataScopePage" resultType="com.budaos.system.domain.entity.StaffEntity">
        SELECT *
        FROM t_employee
        WHERE deleted_flag = 0
        <if test="departmentIds != null and departmentIds.size() > 0">
            AND department_id IN
            <foreach collection="departmentIds" open="(" close=")" item="item" separator=",">
                #{item}
            </foreach>
        </if>
    </select>

</mapper>
