<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.budaos.ai.session.mapper.AiragMessageMapper">

    <resultMap id="BaseResultMap" type="com.budaos.ai.session.entity.AiragMessage">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="reasoning_content" property="reasoningContent"/>
        <result column="tool_calls" property="toolCalls"/>
        <result column="tool_call_id" property="toolCallId"/>
        <result column="tool_name" property="toolName"/>
        <result column="input_tokens" property="inputTokens"/>
        <result column="output_tokens" property="outputTokens"/>
        <result column="total_tokens" property="totalTokens"/>
        <result column="model_name" property="modelName"/>
        <result column="response_time" property="responseTime"/>
        <result column="status" property="status"/>
        <result column="error_msg" property="errorMsg"/>
        <result column="metadata" property="metadata"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, create_time, tenant_id, session_id, role, content, reasoning_content,
        tool_calls, tool_call_id, tool_name, input_tokens, output_tokens, total_tokens,
        model_name, response_time, status, error_msg, metadata
    </sql>

    <select id="selectBySessionId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM airag_message
        WHERE session_id = #{sessionId}
        ORDER BY create_time ASC
    </select>

    <select id="selectRecentMessages" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM airag_message
        WHERE session_id = #{sessionId}
        ORDER BY create_time DESC
        LIMIT #{limit}
    </select>

    <select id="countBySessionId" resultType="int">
        SELECT COUNT(*)
        FROM airag_message
        WHERE session_id = #{sessionId}
    </select>

    <select id="sumTokensBySessionId" resultType="int">
        SELECT COALESCE(SUM(total_tokens), 0)
        FROM airag_message
        WHERE session_id = #{sessionId}
    </select>

</mapper>
